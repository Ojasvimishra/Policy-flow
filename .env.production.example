# ==============================================================================
# PolicyFlow Production Environment Template (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production on your deployment target server:
#    cp .env.production.example .env.production
# 2. Generate a fresh application encryption key:
#    php artisan key:generate --show
#    and paste the base64 value into APP_KEY.
# 3. Supply strong, unique production passwords for PostgreSQL and Redis.
# 4. NEVER commit .env.production or any secret-bearing configuration to git.
# ==============================================================================

APP_NAME=PolicyFlow
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://policyflow.yourdomain.com
APP_LOCALE=en

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

# Operational Logging (Production Container Stdout/Stderr for Docker & Log Collectors)
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Production Database: PostgreSQL 16
# In Docker Compose, DB_HOST should point to the db service container 'db'.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=policyflow
DB_USERNAME=policyflow_user
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_POSTGRES_PASSWORD

# Distributed Session, Queue, & Cache Storage: Redis 7
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=policyflow_prod_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Production Mail Driver (SMTP, Postmark, SES, or Mailgun)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@trippersshield.internal"
MAIL_FROM_NAME="${APP_NAME}"

# Insurer Integration Configuration
# For production pilot / sandbox simulation, configure provider gateway settings below:
MOCK_INSURER_ENABLED=true
MOCK_INSURER_DEFAULT_SCENARIO=SUCCESS
MOCK_INSURER_TIMEOUT_SECONDS=10
MOCK_INSURER_BASE_URL=http://app:9000/api/mock-insurer
MOCK_INSURER_WEBHOOK_URL=http://app:9000/api/mock-insurer/callback

# Background Reconciliation Engine Configuration
# Policies in PENDING_CONFIRMATION older than STALE_THRESHOLD will be verified against insurer
RECONCILIATION_INTERVAL_MINUTES=5
RECONCILIATION_STALE_THRESHOLD_MINUTES=10
