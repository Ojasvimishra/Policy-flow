APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default Database: PostgreSQL (Recommended for robust concurrency & transactional integrity)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=policyflow
DB_USERNAME=policyflow_user
DB_PASSWORD=secret_local_password

# Alternative Database: MySQL 8+ (Uncomment if using MySQL)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=policyflow
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=policyflow_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mock Insurer Simulation Settings (Development & Testing only)
MOCK_INSURER_ENABLED=true
MOCK_INSURER_DEFAULT_SCENARIO=SUCCESS
MOCK_INSURER_TIMEOUT_SECONDS=5
MOCK_INSURER_BASE_URL=http://localhost:8000/api/mock-insurer
MOCK_INSURER_WEBHOOK_URL=http://localhost:8000/api/mock-insurer/callback

# Background Reconciliation Configuration
RECONCILIATION_INTERVAL_MINUTES=5
RECONCILIATION_STALE_THRESHOLD_MINUTES=10

# Frontend Development
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=http://localhost:8000/api
